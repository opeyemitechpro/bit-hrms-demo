APP_NAME="BIT-HRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1,::1

# Database configuration (PostgreSQL recommended for production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bit_hrms_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# For MySQL local development (comment out PostgreSQL above and uncomment below)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bit_hrms_db
# DB_USERNAME=root
# DB_PASSWORD=

AGENCY_NAME="Bureau of Information Technology"
GOVERNMENT_NAME="Ogun State Government, Nigeria"

# Cache & Session (no Redis service required)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="BIT-HRMS"

# Vite Frontend
VITE_API_URL=http://localhost:8000/api
